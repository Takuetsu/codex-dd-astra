load("@crates//:defs.bzl", "aliases")
load("//:defs.bzl", "codex_rust_crate")

# A workspace Cargo package is pinned as noyalib-serde-yaml but imported
# as serde_yaml. Limit the generated alias to this one package; passing every
# generated alias to all workspace crates created a Bazel transition cycle.
_yaml_aliases = {dep: local for dep, local in aliases().items() if local == "serde_yaml"}
# BUILD files disallow top-level if statements; source regression checks guard this exact alias.

codex_rust_crate(
    name = "skills",
    compile_data = glob(
        include = ["**"],
        allow_empty = True,
        exclude = [
            "**/* *",
            "BUILD.bazel",
            "Cargo.toml",
        ],
    ),
    crate_name = "codex_skills",
    lib_aliases = _yaml_aliases,
)
