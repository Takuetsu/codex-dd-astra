{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadAdaptiveValidationStatus": {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "failedStage": {
          "type": [
            "string",
            "null"
          ]
        },
        "failureFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "headSha": {
          "type": "string"
        },
        "logPath": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        }
      },
      "required": [
        "headSha",
        "logPath",
        "profile",
        "result",
        "runId"
      ],
      "type": "object"
    },
    "ThreadAdaptiveWorkflowState": {
      "properties": {
        "attemptNumber": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "authorizedScope": {
          "type": [
            "string",
            "null"
          ]
        },
        "complexityClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "implementationPhase": {
          "type": [
            "string",
            "null"
          ]
        },
        "pausedByUser": {
          "type": "boolean"
        },
        "startingFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "validationRepairCyclesUsed": {
          "format": "uint8",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "validationRepairFingerprint": {
          "type": [
            "string",
            "null"
          ]
        },
        "validationStatus": {
          "anyOf": [
            {
              "$ref": "#/definitions/ThreadAdaptiveValidationStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "validationTargetedRetestRequired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "workerAssignmentLocked": {
          "type": "boolean"
        },
        "workerRole": {
          "type": "string"
        },
        "workflowTerminal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "attemptNumber",
        "enabled",
        "pausedByUser",
        "workerAssignmentLocked",
        "workerRole"
      ],
      "type": "object"
    },
    "ThreadWorkflowStateOperation": {
      "enum": [
        "setReadyForOwnerQa",
        "setAdaptiveState",
        "clear"
      ],
      "type": "string"
    }
  },
  "properties": {
    "adaptiveState": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadAdaptiveWorkflowState"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "$ref": "#/definitions/ThreadWorkflowStateOperation"
    },
    "sourceTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "operation",
    "threadId"
  ],
  "title": "ThreadWorkflowStateUpdateParams",
  "type": "object"
}